---
import { Bike, Droplets, Wind } from "@lucide/svelte";
import { Button } from "$lib/components/ui/button";

const sources = [
  { label: "Wind", icon: Wind },
  { label: "Hydro", icon: Droplets },
  { label: "Pedal", icon: Bike },
];
---

<section class="bg-[radial-gradient(ellipse_at_top,--theme(--color-primary/15%),transparent_70%)]">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-2 lg:py-32">
    <div class="flex flex-col items-center text-center lg:items-start lg:text-left">
      <p class="mb-6 rounded-full border border-primary/20 bg-accent px-3 py-1 text-xs font-medium text-accent-foreground">
        Open Source Hardware
      </p>
      <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-6xl">
        Turn rotation into <span class="text-primary">electricity</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-pretty text-muted-foreground">
        Spinvert is a boost converter with active rectification for small wind turbines, micro-hydro
        and pedal generators — efficiently harvesting energy even at low speeds.
      </p>
      <ul class="mt-8 flex flex-wrap justify-center gap-6 text-sm text-muted-foreground lg:justify-start">
        {sources.map(({ label, icon: Icon }) => (
          <li class="flex items-center gap-2">
            <Icon class="size-4 text-primary" aria-hidden="true" />
            {label}
          </li>
        ))}
      </ul>
      <div class="mt-10 flex flex-wrap justify-center gap-3 lg:justify-start">
        <Button href="https://github.com/spinvert/spinvert-boost-4820" size="lg" class="px-4">
          Explore on GitHub
        </Button>
        <Button href="/theory/" variant="outline" size="lg" class="px-4">
          Learn the theory
        </Button>
      </div>
    </div>
    <a href="/hardware/boost-4820/" class="relative mx-auto block max-w-xl lg:max-w-none">
      <img
        src="/spinvert-boost-4820-iso.webp"
        alt="Rendering of the Spinvert Boost 4820 circuit board"
        width="800"
        height="533"
        fetchpriority="high"
        class="h-auto w-full"
      />
      <!-- Rubber-stamp style beta notice on top of the board rendering -->
      <div class="absolute bottom-[12%] left-[5%] -rotate-12 rounded-lg bg-background/75 backdrop-blur-sm border-[3px] border-double border-red-600/80 px-3 py-1.5 text-center text-red-600/80 uppercase dark:border-red-400/80 dark:text-red-400/80">
        <p class="text-2xl leading-none font-black tracking-[0.2em] sm:text-3xl">Beta</p>
        <p class="mt-1 text-[0.625rem] leading-tight font-bold tracking-wider sm:text-xs">
          Prototypes
          <br />
          in testing
        </p>
      </div>
    </a>
  </div>
</section>
