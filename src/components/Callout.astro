---
import { cn } from "$lib/utils";

interface Props {
  type?: "note" | "caution";
  title?: string;
}

const { type = "note", title } = Astro.props;
---

<aside
  class={cn(
    "not-prose my-6 rounded-md border-l-4 bg-muted/50 px-4 py-3 text-sm [&_a]:text-primary [&_a:hover]:underline [&_p+p]:mt-2",
    type === "caution" ? "border-destructive" : "border-primary",
  )}
>
  {title && <p class="mb-1 font-medium">{title}</p>}
  <slot />
</aside>
