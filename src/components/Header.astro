---
import { Zap } from "@lucide/svelte";
import { Button } from "$lib/components/ui/button";
import { navLinks, site } from "$lib/site";
import GitHubIcon from "./GitHubIcon.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="sticky top-0 z-50 border-b bg-background/80 backdrop-blur">
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
      <Zap class="size-5 fill-primary text-primary" aria-hidden="true" />
      {site.name}
    </a>
    <div class="flex items-center gap-1 sm:gap-2">
      {
        navLinks.map((link) => (
          <Button href={link.href} variant="ghost" size="sm" class="hidden sm:inline-flex">
            {link.label}
          </Button>
        ))
      }
      <ThemeToggle />
      <Button href={site.repoUrl} variant="ghost" size="icon" aria-label="Spinvert on GitHub">
        <GitHubIcon class="size-5" />
      </Button>
    </div>
  </nav>
</header>
