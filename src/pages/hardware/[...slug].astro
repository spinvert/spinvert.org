---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import { docPages } from "$lib/docs";
import Callout from "~/components/Callout.astro";
import DocsLayout from "~/layouts/DocsLayout.astro";

export const getStaticPaths = (async () => {
  const entries = await getCollection("hardware");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// Each product has its own folder, e.g. boost-4820/, with index page "boost-4820"
const product = entry.id.split("/")[0];
const pages = await docPages(
  "hardware",
  (other) => other.id === product || other.id.startsWith(`${product}/`),
);
const productIndex = (await getCollection("hardware")).find((other) => other.id === product);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  headings={headings}
  section={productIndex?.data.section ?? "Hardware"}
  pages={pages}
>
  <!-- Shown at the top of every hardware page during the beta phase -->
  <Callout type="caution" title="Beta: prototypes in testing">
    <p>
      The first prototypes of hardware version v0.1 are currently being built and tested. The design
      and documentation may still change based on the test results. Building and operating the
      hardware is at your own risk.
    </p>
  </Callout>
  <Content />
</DocsLayout>
