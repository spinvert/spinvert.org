---
import "katex/dist/katex.min.css";
import Layout from "~/layouts/Layout.astro";

interface Props {
  frontmatter: {
    title?: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
---

<Layout title={frontmatter.title} description={frontmatter.description}>
  <!-- Same container as header and footer, text column kept at a readable width -->
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <article class="prose max-w-3xl prose-neutral dark:prose-invert prose-headings:tracking-tight prose-a:text-primary prose-a:no-underline prose-a:hover:underline">
      <slot />
    </article>
  </div>
</Layout>
