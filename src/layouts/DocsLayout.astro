---
import "katex/dist/katex.min.css";
import { ChevronLeft, ChevronRight } from "@lucide/svelte";
import type { MarkdownHeading } from "astro";
import { type CollectionEntry, getCollection } from "astro:content";
import { cn } from "$lib/utils";
import Layout from "~/layouts/Layout.astro";

interface Props {
  entry: CollectionEntry<"docs">;
  headings: MarkdownHeading[];
}

const { entry, headings } = Astro.props;

const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
const href = (doc: CollectionEntry<"docs">) => (doc.id === "index" ? "/docs/" : `/docs/${doc.id}/`);
const index = docs.findIndex((doc) => doc.id === entry.id);
const prev = docs[index - 1];
const next = docs[index + 1];
const toc = headings.filter((heading) => heading.depth === 2);
---

<Layout title={entry.data.title} description={entry.data.description}>
  <div class="mx-auto flex max-w-6xl gap-10 px-4 py-12 sm:px-6">
    <nav aria-label="Documentation" class="hidden w-52 shrink-0 lg:block">
      <ul class="sticky top-20 space-y-1 text-sm">
        {docs.map((doc) => (
          <li>
            <a
              href={href(doc)}
              aria-current={doc.id === entry.id ? "page" : undefined}
              class={cn(
                "block rounded-md px-3 py-1.5 text-muted-foreground hover:bg-accent hover:text-accent-foreground",
                doc.id === entry.id && "bg-accent font-medium text-accent-foreground",
              )}
            >
              {doc.data.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="min-w-0 flex-1">
      <!-- Compact page selector replacing the sidebar on small screens -->
      <details class="mb-8 rounded-md border text-sm lg:hidden">
        <summary class="cursor-pointer px-3 py-2 font-medium">Documentation pages</summary>
        <ul class="border-t px-3 py-2">
          {docs.map((doc) => (
            <li>
              <a
                href={href(doc)}
                class={cn(
                  "block py-1 text-muted-foreground hover:text-foreground",
                  doc.id === entry.id && "font-medium text-foreground",
                )}
              >
                {doc.data.title}
              </a>
            </li>
          ))}
        </ul>
      </details>

      <article class="prose max-w-3xl prose-neutral dark:prose-invert prose-headings:scroll-mt-20 prose-headings:tracking-tight prose-a:text-primary prose-a:no-underline prose-a:hover:underline">
        <h1>{entry.data.title}</h1>
        <slot />
      </article>

      <nav
        aria-label="Previous and next page"
        class="mt-16 flex max-w-3xl justify-between gap-4 border-t pt-6 text-sm"
      >
        {prev ? (
          <a
            href={href(prev)}
            class="flex items-center gap-1 text-muted-foreground hover:text-foreground"
          >
            <ChevronLeft class="size-4" aria-hidden="true" />
            {prev.data.title}
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a
            href={href(next)}
            class="flex items-center gap-1 text-muted-foreground hover:text-foreground"
          >
            {next.data.title}
            <ChevronRight class="size-4" aria-hidden="true" />
          </a>
        )}
      </nav>
    </div>

    {toc.length > 1 && (
      <nav aria-label="On this page" class="hidden w-48 shrink-0 xl:block">
        <div class="sticky top-20 text-sm">
          <p class="mb-2 font-medium">On this page</p>
          <ul class="space-y-1.5">
            {toc.map((heading) => (
              <li>
                <a href={`#${heading.slug}`} class="text-muted-foreground hover:text-foreground">
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    )}
  </div>
</Layout>
