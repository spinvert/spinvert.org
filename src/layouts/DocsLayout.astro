---
import "katex/dist/katex.min.css";
import { ChevronLeft, ChevronRight } from "@lucide/svelte";
import type { MarkdownHeading } from "astro";
import type { DocPage } from "$lib/docs";
import { cn } from "$lib/utils";
import Layout from "~/layouts/Layout.astro";

interface Props {
  title: string;
  description?: string;
  headings: MarkdownHeading[];
  /** Name of the documentation section, shown above the page list */
  section: string;
  /** All pages of the section in sidebar order */
  pages: DocPage[];
}

const { title, description, headings, section, pages } = Astro.props;

const index = pages.findIndex((page) => page.href === Astro.url.pathname);
const prev = pages[index - 1];
const next = pages[index + 1];
const toc = headings.filter((heading) => heading.depth === 2);
---

<Layout title={title} description={description}>
  <div class="mx-auto flex max-w-6xl gap-10 px-4 py-12 sm:px-6">
    <nav aria-label={section} class="hidden w-52 shrink-0 lg:block">
      <div class="sticky top-20 text-sm">
        <p class="mb-2 px-3 font-medium">{section}</p>
        <ul class="space-y-1">
          {pages.map((page, i) => (
            <li>
              <a
                href={page.href}
                aria-current={i === index ? "page" : undefined}
                class={cn(
                  "block rounded-md px-3 py-1.5 text-muted-foreground hover:bg-accent hover:text-accent-foreground",
                  i === index && "bg-accent font-medium text-accent-foreground",
                )}
              >
                {page.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>

    <div class="min-w-0 flex-1">
      <!-- Compact page selector replacing the sidebar on small screens -->
      <details class="mb-8 rounded-md border text-sm lg:hidden">
        <summary class="cursor-pointer px-3 py-2 font-medium">{section}</summary>
        <ul class="border-t px-3 py-2">
          {pages.map((page, i) => (
            <li>
              <a
                href={page.href}
                class={cn(
                  "block py-1 text-muted-foreground hover:text-foreground",
                  i === index && "font-medium text-foreground",
                )}
              >
                {page.title}
              </a>
            </li>
          ))}
        </ul>
      </details>

      <article class="prose max-w-3xl prose-neutral dark:prose-invert prose-headings:scroll-mt-20 prose-headings:tracking-tight prose-a:text-primary prose-a:no-underline prose-a:hover:underline">
        <h1>{title}</h1>
        <slot />
      </article>

      <nav
        aria-label="Previous and next page"
        class="mt-16 flex max-w-3xl justify-between gap-4 border-t pt-6 text-sm"
      >
        {prev ? (
          <a
            href={prev.href}
            class="flex items-center gap-1 text-muted-foreground hover:text-foreground"
          >
            <ChevronLeft class="size-4" aria-hidden="true" />
            {prev.title}
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a
            href={next.href}
            class="flex items-center gap-1 text-muted-foreground hover:text-foreground"
          >
            {next.title}
            <ChevronRight class="size-4" aria-hidden="true" />
          </a>
        )}
      </nav>
    </div>

    {toc.length > 1 && (
      <nav aria-label="On this page" class="hidden w-48 shrink-0 xl:block">
        <div class="sticky top-20 text-sm">
          <p class="mb-2 font-medium">On this page</p>
          <ul class="space-y-1.5">
            {toc.map((heading) => (
              <li>
                <a href={`#${heading.slug}`} class="text-muted-foreground hover:text-foreground">
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    )}
  </div>
</Layout>
